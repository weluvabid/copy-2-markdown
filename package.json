{
  "name": "copy-2-markdown",
  "version": "1.0.0",
  "private": true,
  "description": "Copy clean Markdown from webpages, selections, and links.",
  "type": "module",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.0.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:types": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm format:check && pnpm check:types && pnpm test && pnpm build",
    "precommit": "pnpm lint && pnpm format:check && pnpm check:types && pnpm test",
    "prepare": "sh ./scripts/install-hooks.sh",
    "test:browser": "playwright test",
    "prepush": "pnpm build && pnpm test:browser"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "0.3.7",
    "@types/node": "26.0.0",
    "@types/turndown": "^5.0.6",
    "eslint": "9.39.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "jsdom": "^30.1.3",
    "prettier": "3.6.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "lucide": "^1.66.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
