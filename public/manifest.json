{
  "manifest_version": 3,
  "name": "Copy 2 Markdown",
  "version": "1.0.0",
  "description": "Copy clean Markdown from webpages, selections, and links.",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "contextMenus", "offscreen"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Copy 2 Markdown",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "commands": {
    "copy-page-markdown": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Alt+Shift+M"
      },
      "description": "Copy page as MD"
    },
    "copy-selection-markdown": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Alt+Shift+L"
      },
      "description": "Copy selection as MD"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/fonts/atkinson-hyperlegible-regular.otf"],
      "matches": ["<all_urls>"]
    }
  ],
  "minimum_chrome_version": "116"
}
